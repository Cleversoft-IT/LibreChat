# =============================================================================
# ClickHouse code-interpreter — production .env (copy to the cloned repo as .env)
# Source stack: https://github.com/ClickHouse/code-interpreter  (docker-compose.yaml)
#
# This file only lists the values that must change from the upstream local-dev
# defaults to run a hardened, authenticated deployment for LibreChat. Everything
# else keeps the compose defaults.
# =============================================================================

# --- Run mode ----------------------------------------------------------------
# Disable the no-auth local mode and enforce JWT auth from LibreChat.
LOCAL_MODE=false
CODEAPI_HARDENED_SANDBOX_MODE=true

# --- Sandbox isolation (KVM / libkrun microVM, upstream default) -------------
# Requires /dev/kvm on the host. Verify with: ls -l /dev/kvm
KVM_ENABLED=true
KVM_DEVICE_PATH=/dev/kvm

# --- LibreChat JWT validation ------------------------------------------------
# issuer / audience / kid MUST match the LibreChat side. Paste the public key
# block produced by deploy/codeapi/gen-jwt-keys.sh (single line, \n-escaped).
CODEAPI_AUTH_PROVIDER=librechat-jwt
CODEAPI_JWT_ALLOWED_ALGS=EdDSA
CODEAPI_JWT_ISSUER=librechat
CODEAPI_JWT_AUDIENCE=codeapi
CODEAPI_JWT_KID=lc-codeapi-1
CODEAPI_JWT_PUBLIC_KEY=

# --- Internal service token --------------------------------------------------
# Shared secret between the codeapi components (api/worker/file_server/...).
# Generate a strong one: openssl rand -hex 32
CODEAPI_INTERNAL_SERVICE_TOKEN=

# --- Egress gateway grant secret (>= 32 bytes) -------------------------------
# Generate: openssl rand -hex 32
CODEAPI_EGRESS_GRANT_SECRET=

# --- Concurrency (tune to the host) ------------------------------------------
PYTHON_CONCURRENCY=1
OTHER_CONCURRENCY=8

# --- Bridge policy (upstream >= 2026-09, pin 9d3936f) -------------------------
# With the compose default CODEAPI_BRIDGE_AUTH_MODE=paired in hardened mode the
# api/worker refuse to start without a strong token (>= 32 bytes), even though we
# do not use bridge workers. Generate: openssl rand -hex 32
CODEAPI_BRIDGE_TOKEN=

# --- Clock-drift liveness ----------------------------------------------------
# The microVM guest clock drifts behind the host; upstream's healthcheck marks
# sandbox-runner unhealthy past SANDBOX_RUNNER_CLOCK_SKEW_LIVENESS_LIMIT_SECONDS
# (compose default 10, keep it) and the autoheal sidecar in the override restarts
# it. Compose does not pass the jitter knob; the override does. Single host => 0.
SANDBOX_RUNNER_CLOCK_SKEW_LIVENESS_JITTER_SECONDS=0

# --- Execution-manifest signing keys (Ed25519, base64 DER pkcs8 / spki) --------
# docker-compose.yaml ships public sample keys; use your own pair:
#   PRIV=$(openssl genpkey -algorithm ed25519 -outform DER | base64 -w0)
#   PUB=$(echo "$PRIV" | base64 -d | openssl pkey -inform DER -pubout -outform DER | base64 -w0)
CODEAPI_EXECUTION_MANIFEST_PRIVATE_KEY=
SANDBOX_EXECUTION_MANIFEST_PUBLIC_KEY=
